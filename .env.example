# Copy to .env and fill in. Never commit .env.
# Layout follows docs/POWER_UP.md Part B (Supabase Postgres + VPS).

# ── Database (Supabase) ────────────────────────────────────────────
# App traffic goes through the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma migrations need a session connection (port 5432): the session pooler
# (IPv4-reachable) or the direct host db.<project-ref>.supabase.co.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# URL-encode special characters in the password (e.g. @ -> %40).
# Local alternative (docker compose up -d), use for BOTH vars:
# DATABASE_URL="postgresql://aegis:aegis_dev_password@localhost:5432/aegis?schema=public"
# DIRECT_URL="postgresql://aegis:aegis_dev_password@localhost:5432/aegis?schema=public"

# Supabase project. Only its Postgres is used today; keys are reserved for
# Supabase Storage (evidence/reports). The service-role key bypasses RLS:
# server-side only, never expose it to the browser.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Auth (our own JWT; Supabase Auth is not used) ──────────────────
# Each at least 32 random chars, and different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""           # signs access tokens (HS256)
JWT_REFRESH_SECRET=""   # HMAC key for hashing refresh/invite tokens at rest
JWT_ISSUER="aegis-api"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_HOURS=72

# ── API server ─────────────────────────────────────────────────────
API_HOST="127.0.0.1"    # keep on loopback behind a reverse proxy on the VPS
API_PORT=4000
CORS_ORIGINS="http://localhost:3000"   # comma-separated browser origins
# Set to "true" when served over HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE="false"

# ── Redis (rate limits now; BullMQ queue from Phase 2) ─────────────
# Required in production. Set maxmemory-policy to noeviction.
REDIS_URL="redis://localhost:6379"

# ── Scope Authorization Gate (Phase 1) ─────────────────────────────
SCOPE_VERIFICATION_TTL_DAYS=90          # verified scopes must re-verify after this
MAX_CONCURRENT_SCANS_PER_ORG=3
SCAN_STARTS_PER_SCOPE_PER_MINUTE=5
# AWS cloud-account verification: our principal that customers trust in their
# read-only role. Platform credentials come from the standard AWS env vars
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION) or an instance role.
AWS_TRUST_PRINCIPAL_ARN=""

# ── Object storage (Supabase Storage S3 endpoint OR any S3-compatible) ─
# Local MinIO: STORAGE_ENDPOINT="http://localhost:9000", key/secret as below.
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="aegis-evidence"
STORAGE_KEY=""
STORAGE_SECRET=""

# ── Vulnerability intel (Phase 3.5) ────────────────────────────────
NVD_API_KEY=""
# EPSS and CISA KEV need no key.

# ── LLM advisory layer (Phase 7; advisory only, never triggers scans) ─
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Enrichment (optional; verified-scope assets only) ──────────────
SHODAN_API_KEY=""
SECURITYTRAILS_API_KEY=""

# ── Notifications (Phase 6) ────────────────────────────────────────
SMTP_URL=""
SLACK_WEBHOOK_URL=""

# ── Web ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── docker-compose (local dev only) ────────────────────────────────
POSTGRES_USER="aegis"
POSTGRES_PASSWORD="aegis_dev_password"
POSTGRES_DB="aegis"
MINIO_ROOT_USER="aegis"
MINIO_ROOT_PASSWORD="aegis_dev_password"
